%% Fonte canonica: docs/diagramas/classes.mmd (repo).
%% Espelho em 01-Projetos/cycling-coach/classes.mmd (vault) - nao editar la.
%% PNG exportado: classes.png. Editar no repo e copiar. Ver docs/DIAGRAMAS.md.
%% CURADORIA: entram so as entidades com contrato verificado por teste ou que
%% vivem em formato persistido/externo (plan.json, payload do Intervals, .env).
%% Nao e lista completa de src/ (ha ~47 dataclasses); ver o criterio no fim.
classDiagram
    direction LR

    class WorkoutParams {
        +str focus
        +int repeats
        +int on_sec
        +int off_sec
        +float on_power
        +float off_power
        +int warmup_sec
        +float on_power_pct
    }
    class PlannedWorkout {
        +str day
        +str focus
        +int planned_duration
        +str name
        +dict params
        +float tss
        +str external_id
    }
    class TrainingPlanState {
        +str start
        +float ftp
        +list workouts
        +dict meta
    }
    class ReadinessEligibility {
        +dict workout
        +str state
        +bool eligible
        +str reason
    }
    class Metrics {
        +float tsb
        +float ctl
        +float atl
        +float tss
        +float ftp
        +str day
    }
    class FtpTestSuggestion {
        +bool due
        +str reason
        +str day
    }

    class ReadinessLevel {
        <<enumeration>>
        GREEN
        YELLOW
        RED
    }
    class ReadinessAssessment {
        +float hrv_score
        +float rhr_score
        +float sleep_score
        +float subjective_fatigue_score
        +float recent_load_score
        +float performance_score
        +float consistency_score
    }
    class ReadinessAction {
        <<enumeration>>
        NONE
        REDUCE
        REPLACE
    }
    class ReadinessDecision {
        +ReadinessAction action
        +str reason
        +ReadinessLevel level
        +float coverage
        +bool illness_alert
        +bool composite_low
        +tuple observations
        +str applies_to_day
    }
    class Readiness {
        +ReadinessDecision decision
        +ReadinessObservation observation
    }
    class ReadinessObservation {
        +float hrv
        +float rhr
        +float sleep
        +str read_at
    }

    class ImpulseResponseEngine {
        +compute()
        +ctl_atl()
    }
    class TrainingLoadComponents {
        +float ctl
        +float atl
        +float tsb
    }

    class IntervalsClient {
        +get_events()
        +get_wellness()
        +get_activity()
        +get_streams()
        +create_events()
        +get_sport_settings()
    }
    class IntervalsApiError {
        +int status
        +str detail
    }
    class RideFtpEstimate {
        +float ftp
        +float ci
        +str method
    }

    class StimulusFamily {
        <<enumeration>>
        sweet_spot
        threshold
        vo2max
        endurance
        anaerobic
    }
    class ProgressionStep {
        +int repeats
        +int work_sec
        +float intensity
        +int recovery_sec
    }
    class CompletionScore {
        +float adherence
        +float intensity_ok
        +float total
    }
    class VO2Family {
        <<enumeration>>
        long_intervals
        short_intervals
        variable_intervals
    }
    class ProgressionLever {
        <<enumeration>>
        interval_duration
        repetitions
        total_work_time
        intensity
    }
    class VO2Workout {
        +VO2Family family
        +int interval_duration
        +int repetitions
        +tuple work_power_range
        +int recovery_duration
        +int total_work_time
        +int progression_step
        +ProgressionLever lever
    }

    class AdaptationState {
        +float aerobic_base
        +float threshold
        +float vo2max
        +float muscular_endurance
        +float anaerobic
        +float neuromuscular
    }
    class CriticalPowerProfile {
        +float critical_power
        +float w_prime
        +CPProtocol protocol
        +CPConfidence confidence
        +tuple test_dates
    }
    class AthletePhysiologicalProfile {
        +int ftp
        +FtpSource ftp_source
        +float ftp_confidence
    }
    class FtpSource {
        <<enumeration>>
        user
        ftp20
        ftp60
        ramp
        cp_estimate
        performance_estimate
    }
    class TrainingPhase {
        <<enumeration>>
        base
        build
        specific
        peak
        recovery
        test
    }
    class PhaseState {
        +TrainingPhase phase
        +int week
    }
    class TrainingDecision {
        +str goal
        +str phase
        +str primary_adaptation
        +str workout_family
        +int progression_step
        +int planned_duration
    }
    class IntensityDistributionModel {
        +float z1_minutes
        +float z2_minutes
        +float z3_minutes
        +float z4_minutes
        +float z5_minutes
    }
    class FamilyProfile {
        +str family
        +tuple band
        +ZoneLever lever
    }
    class ZoneLever {
        <<enumeration>>
        duration
        total_volume
        repetitions
        recovery
    }

    PlannedWorkout --> WorkoutParams : params (dict, contrato persistido)
    TrainingPlanState --> PlannedWorkout : workouts
    TrainingPlanState --> ReadinessEligibility : elegibilidade por dia
    Metrics --> TrainingLoadComponents : TSB/CTL/ATL
    ImpulseResponseEngine ..> TrainingLoadComponents : produz
    IntervalsClient ..> IntervalsApiError : levanta

    Readiness --> ReadinessDecision : decision
    Readiness --> ReadinessObservation : observation
    ReadinessDecision --> ReadinessAction : action
    ReadinessDecision --> ReadinessLevel : level
    ReadinessDecision ..> ReadinessEligibility : is_adaptive + applies_to_day
    ReadinessDecision --> WorkoutParams : REDUCE preserva focus
    PlannedWorkout --> ReadinessAssessment : 7 eixos lidos do wellness

    ProgressionStep --> StimulusFamily : pertence a
    CompletionScore ..> ProgressionStep : avaliado contra
    VO2Workout --> VO2Family : family
    VO2Workout --> ProgressionLever : lever
    VO2Workout ..> WorkoutParams : 4x4 / 5x3 / 3x5

    TrainingDecision --> TrainingPhase : phase
    TrainingPhase --> PhaseState : state
    TrainingDecision --> FamilyProfile : workout_family
    FamilyProfile --> ZoneLever : lever
    TrainingDecision ..> ProgressionStep : progression_step
    TrainingDecision ..> AthletePhysiologicalProfile : FTP
    AdaptationState ..> TrainingDecision : adaptações
    CriticalPowerProfile ..> TrainingDecision : CP/W' (fora da publicação)
    IntensityDistributionModel ..> TrainingDecision : minutos por zona