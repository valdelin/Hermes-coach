{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openai",
    "opencode",
    "google"
  ],
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      "htmlcov/**",
      "coverage/**",
      "dist/**",
      "build/**",
      "*.egg-info/**",
      "node_modules/**"
    ]
  },
  "permission": {
    "edit": "allow",
    "bash": "ask"
  }
}
