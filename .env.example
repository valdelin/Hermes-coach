INTERVALS_ATHLETE_ID=000000
INTERVALS_API_KEY=sua_api_key_aqui
FTP=200
CUE_LANG=pt  # idioma das mensagens dos treinos (pt|en)
# TRAINING_DAYS=seg,ter,qua,qui,sex  # dias de treino (seg..dom ou mon..sun).
# Se ausente ou invalido, usa seg-sex.
# Disponibilidade semanal (o agente pergunta no 1o uso; exemplos abaixo):
#WEEKLY_HOURS=5          # horas disponiveis por semana (o build ajusta as duracoes)
#LONG_DAY=dom            # dia preferido para treinos longos (seg..dom ou mon..sun)
# GOAL=back-to-fitness  # tipo de plano: back-to-fitness|ftp-builder|gran-fondo|
#                       # time-trial|climbing|active-off-season|race
# RACE_DATE=2026-12-01  # data alvo (dia da prova) - necessario quando GOAL=race
# FTP_TEST_DATE=2026-10-22  # data do Ramp Test: build protege as 48h antes
# PERIODIZATION=polarized  # modelo de periodizacao (opcional; ajusta a semana):
#                          # polarized|pyramidal|undulating|linear|block
# COACH_WEBHOOK=https://exemplo.com/webhook  # (opcional) recebe alerta de
#                          # inicio de doenca quando o `check` detecta
